# ---- Supabase (new project, separate from the HTH intake app) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-NEW-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=stub-anon-key
SUPABASE_SERVICE_ROLE_KEY=stub-service-role-key

# ---- Google Calendar (service account) ----
# Create a GCP project + service account, enable the Calendar API, download the
# JSON key, then base64-encode the whole file into this single env var:
#   (mac/linux)  base64 -i service-account.json | tr -d '\n'
#   (powershell) [Convert]::ToBase64String([IO.File]::ReadAllBytes("service-account.json"))
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=stub-base64-service-account-json

# Rene's Google Calendar ID (usually their calendar's email address, or the long
# ID shown under Google Calendar > Settings > [calendar] > "Integrate calendar").
# The calendar must be shared with the service account's client_email as
# "Make changes to events".
RENE_GOOGLE_CALENDAR_ID=stub-calendar-id@group.calendar.google.com

# ---- ActiveCampaign ----
ACTIVECAMPAIGN_API_URL=https://youraccount.api-us1.com
ACTIVECAMPAIGN_API_KEY=stub-ac-api-key

# ---- Admin page (HTTP Basic Auth) ----
ADMIN_BASIC_AUTH_USER=admin
ADMIN_BASIC_AUTH_PASSWORD=change-me

# ---- Cron security ----
# Vercel Cron sends this as a Bearer token (Authorization header) so the
# /api/cron/* routes can't be triggered by anyone who finds the URL.
CRON_SECRET=stub-cron-secret

# ---- Misc ----
# Public base URL of this deployed app, used in generated links/emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000
